[Unit]
Description=Storage Room App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=storage-room
Group=storage-room
WorkingDirectory=/opt/storage-room-app
Environment=HOST=127.0.0.1
Environment=PORT=5432
Environment=COOKIE_SECURE=1
ExecStart=/usr/bin/python3 /opt/storage-room-app/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/storage-room-app/data

[Install]
WantedBy=multi-user.target
